---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { works } from '../data/site';
---
<Base title="Works — House of Haesung">
  <div class="intro">
    <p data-ko='<span class="accent">상설 관람 가능</span>한 작업 목록. <span class="sent">견적 및 상담은 문의 부탁드립니다.</span>'>Selected works for <span class="accent">permanent viewing</span>. <span class="sent">Please contact for further inquiries.</span></p>
  </div>

  <section class="grid">
    {works.map((w) => (
      <a class="card" href={`/projects/${w.slug}/`} data-veil>
        {w.video ? <video src={w.video} poster={w.image} autoplay muted loop playsinline preload="metadata" aria-label={w.title}></video> : <img src={w.image} alt={w.title} width="208" height="203" loading="lazy" />}
        <h2>{w.title}<br />{w.category}</h2>
        <p class="script">{w.year}</p>
      </a>
    ))}
  </section>

  <Footer />
</Base>

<style>
  .intro {
    display: grid; place-items: center;
    min-height: 77px; padding: 12px 20px;
    border-bottom: 3px solid var(--band);
    text-align: center;
  }
  .intro p { margin: 0; word-break: keep-all; text-wrap: balance; }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 370px;
    column-gap: 52px;
    padding: 0;
    /* 양끝 카드 테두리가 틀이 되어, 가로선이 좌우로 잘린 자국 없이 닫힘 */
    /* 행 사이 가로선 */
    background: repeating-linear-gradient(to bottom, transparent 0 367px, var(--band) 367px 370px);
  }
  .card {
    display: flex; flex-direction: column;
    padding: 20px 20px 18px;
    border-inline: 3px solid var(--band);
  }
  .card img, .card video { transition: opacity 0.6s var(--ease); }
  .card:hover img, .card:hover video { opacity: 0.8; }
  .card img, .card video { display: block; width: 100%; aspect-ratio: 208 / 203; object-fit: cover; }
  .card h2 { margin: 28px 0 0; font-size: 15px; font-weight: 600; line-height: 1.2; }
  .card p { margin: auto 0 0; padding-top: 24px; font-size: 18px; }

  @media (max-width: 1199px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 809px) {
    .intro :global(.sent) { display: block; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0; padding: 0; }
    .card { border-left: 0; }
  }
</style>
