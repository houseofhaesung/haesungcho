---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { about } from '../data/site';

const langs = (['en', 'ko'] as const).map((code) => ({ code, d: about[code] }));
const nl = (t: string) => t.split('\n');
---
<Base title="About — House of Haesung">
  <section class="hero">
    <h1 class="script">About</h1>
    {langs.map(({ code, d }) => (
      <p class={`intro only-${code}`}>
        {d.introLead && <strong class="lead">{d.introLead}<br /></strong>}
        {d.intro.map((t) => <>{t}<br /></>)}
        <a class="accent comet" href={d.introLink} target="_blank" rel="noopener" data-text={d.introAccent}>{d.introAccent}</a>
      </p>
    ))}
  </section>

  {langs.map(({ code, d }) => (
    <section class={`cols only-${code}`} lang={code}>
      <div class="col bio">
        <h2>{d.heads.bio}</h2>
        {d.biography.map((para) => <p>{nl(para).map((t, i) => <>{i > 0 && <br />}{t}</>)}</p>)}
      </div>
      {([['experience', d.experience], ['education', d.education], ['exhibition', d.exhibition]] as const).map(([key, items]) => (
        <div class={`col ${key}`}>
          <h2>{d.heads[key]}</h2>
          <ul>
            {items.map((it) => (
              <li><span class="yr">{it.year}</span><span>{it.lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</span></li>
            ))}
          </ul>
        </div>
      ))}
      <img class="ph ph-portrait" src="/images/about/portrait.jpg" alt="Haesung Cho at graduation" />
      <video class="ph ph-desk" src="/videos/about/studio.mp4" poster="/videos/about/studio-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="Studio animation"></video>
      <img class="ph ph-exhibition" src="/images/about/exhibition.jpg" alt="Exhibition view" />
    </section>
  ))}

  <Footer />
</Base>

<style>
  .hero {
    display: grid; justify-items: center; align-content: center;
    min-height: 298px; padding: 60px 20px 70px;
    border-bottom: 3px solid var(--band);
    text-align: center;
  }
  .hero h1 { margin: 0 0 14px; font-size: clamp(44px, 6vw, 64px); line-height: 1; }
  .hero p { margin: 0; line-height: 1.15; }
  .hero .lead { font-weight: 700; }
  /* 호버하면 굵게. 굵은 글자 너비를 미리 잡아둬서 줄이 흔들리지 않음 */
  .comet { display: inline-grid; justify-items: center; transition: font-weight 0.3s var(--ease); }
  .comet::after { content: attr(data-text); font-weight: 700; visibility: hidden; height: 0; overflow: hidden; }
  .comet:hover { font-weight: 700; }
  /* 소개 문구 칸 높이를 언어와 관계없이 고정 → 전환해도 About 제목이 움직이지 않음 */
  .hero .intro { height: 72px; }
  :global(:root[data-lang='ko']) .hero p { line-height: 24px; font-size: 16px; }
  /* 언어별 블록: 한글 선택 시 영문 숨김, 반대도 동일 */
  .only-ko { display: none !important; }
  :global(:root[data-lang='ko']) .only-ko { display: revert !important; }
  :global(:root[data-lang='ko']) section.only-ko { display: grid !important; }
  :global(:root[data-lang='ko']) .only-en { display: none !important; }
  .col p + p { margin-top: 1.1em; }
  [lang='ko'] .col h2 { font-weight: 600; }
  [lang='ko'] .yr { font-weight: 700; font-size: 12.5px; }
  [lang='ko'] .col li { grid-template-columns: 38px 1fr; }
  /* 한글: 단어 중간 줄바꿈 금지, 행간 넉넉하게, 숫자는 라이닝 숫자 */
  [lang='ko'], .hero .only-ko { word-break: keep-all; font-variant-numeric: lining-nums; }
  /* 한글: 시안의 줄바꿈 그대로, 경력은 항목당 세 줄. 줄이 넘치지 않도록 크기를 칸에 맞춤 */
  [lang='ko'] .col p, [lang='ko'] .col li > span:last-child { white-space: nowrap; }
  [lang='ko'] .col p { font-size: 12px; line-height: 1.75; letter-spacing: -0.035em; }
  [lang='ko'] .col ul { font-size: 12px; line-height: 1.6; letter-spacing: -0.03em; gap: 18px; }
  [lang='ko'] .yr { font-family: 'Gowun Batang', serif; font-size: 12px; letter-spacing: 0; }
  [lang='ko'] .col li { grid-template-columns: 40px 1fr; }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'bio exp edu exh'
      'p1  exp p2  p3';
    gap: 24px 18px;
    padding: 20px 24px 44px;
    align-items: start;
  }
  .bio { grid-area: bio; } .experience { grid-area: exp; }
  .education { grid-area: edu; } .exhibition { grid-area: exh; }
  .ph-portrait { grid-area: p1; } .ph-desk { grid-area: p2; } .ph-exhibition { grid-area: p3; }
  .col h2 { margin: 0 0 12px; font-size: 16px; font-weight: 600; }
  .col p { margin: 0; font-size: 13px; line-height: 1.3; }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; font-size: 12.5px; line-height: 1.35; }
  .col li { display: grid; grid-template-columns: 33px 1fr; }
  .yr { font-size: 11.5px; }
  video.ph { display: block; }
  .ph { width: 100%; aspect-ratio: 287 / 200; object-fit: cover; filter: grayscale(1); }

  @media (max-width: 1199px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'bio exp' 'p1 exp' 'edu exh' 'p2 p3';
    }
  }
  @media (max-width: 809px) {
    .hero { min-height: 220px; padding: 40px 20px 50px; }
    .cols {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'bio' 'p1' 'exp' 'edu' 'p2' 'exh' 'p3';
      padding: 20px 50px 50px; gap: 30px;
    }
  }
</style>
