---
interface Props { monogram?: boolean }
const { monogram = false } = Astro.props;
---
{monogram && (
  <div class="monogram-block">
    <img src="/images/monogram.png" alt="" width="100" height="100" />
  </div>
)}
<footer class="site-footer">
  <p>Copyright ©haesungcho<br />All rights reserved</p>
</footer>

{monogram && (
  <script is:inline>
    {
      const img = document.querySelector('.monogram-block img');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (img && !reduce && matchMedia('(hover: hover)').matches) {
        const TURN_MS = 2400;
        // 스프링 곡선: 살짝 지나쳤다가 두어 번 흔들리며 멈춤
        const SPRING = 'linear(0, 0.21 6%, 0.66 15%, 1.04 25%, 1.17 31%, 1.13 37%, 1.02 45%, 0.96 52%, 0.97 60%, 1.01 70%, 1 100%)';
        let anim = null;
        const angleNow = () => {
          const m = new DOMMatrix(getComputedStyle(img).transform);
          return (Math.atan2(m.b, m.a) * 180 / Math.PI + 360) % 360;
        };
        img.addEventListener('mouseenter', () => {
          const from = anim ? angleNow() : 0;
          if (anim) anim.cancel();
          anim = img.animate(
            [{ transform: `rotate(${from}deg)` }, { transform: `rotate(${from + 360}deg)` }],
            { duration: TURN_MS, iterations: Infinity, easing: 'linear' }
          );
        });
        img.addEventListener('mouseleave', () => {
          if (!anim) return;
          const from = angleNow();
          anim.cancel();
          // 가까운 쪽으로 되돌아감 (반 바퀴 넘었으면 앞으로, 아니면 뒤로)
          const to = from > 180 ? 360 : 0;
          const opts = { duration: 1100, easing: SPRING, fill: 'forwards' };
          try { anim = img.animate([{ transform: `rotate(${from}deg)` }, { transform: `rotate(${to}deg)` }], opts); }
          catch (e) { anim = img.animate([{ transform: `rotate(${from}deg)` }, { transform: `rotate(${to}deg)` }], { ...opts, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }); }
        });
      }
    }
  </script>
)}
