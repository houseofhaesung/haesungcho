---
import { nav } from '../data/site';
const all = [nav.home, ...nav.left, ...nav.right];
---
<header class="site-header">
  <nav class="nav" aria-label="Main">
    <div class="nav-side nav-left">
      {nav.left.map((l) => <a href={l.href} data-veil data-ko={l.ko}>{l.label}</a>)}
    </div>
    <a class="home" href={nav.home.href} data-veil data-ko={nav.home.ko}>{nav.home.label}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-ko={nav.home.ko}>
      {nav.home.label}
    </button>
    <div class="nav-side nav-right">
      <button class="translate" type="button" data-toggle-lang aria-pressed="false" aria-label="Translate (English / 한국어)" data-ko="번역">Translate</button>
      {nav.right.map((l) => <a href={l.href} data-veil={!l.href.startsWith('mailto:') || undefined} data-ko={l.ko}>{l.label}</a>)}
    </div>
  </nav>
  <div class="mobile-menu" id="mobile-menu">
    {all.map((l) => (
      <a href={l.href} data-veil={!l.href.startsWith('mailto:') || undefined} data-ko={l === nav.home ? '홈' : l.ko}>
        {l === nav.home ? 'Home' : l.label}
      </a>
    ))}
    <button class="translate" type="button" data-toggle-lang aria-pressed="false" aria-label="Translate (English / 한국어)" data-ko="번역">Translate</button>
  </div>
</header>
